[Unit]
Description=Cloudflare quick tunnel — garmin-web (random *.trycloudflare.com URL)
After=network.target garmin-web.service

[Service]
Type=simple
User=sergiwez
ExecStart=/usr/bin/cloudflared tunnel --url http://localhost:8000
StandardOutput=append:/home/sergiwez/projects/garmin-coach/cloudflared_tunnel.log
StandardError=append:/home/sergiwez/projects/garmin-coach/cloudflared_tunnel.log
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
